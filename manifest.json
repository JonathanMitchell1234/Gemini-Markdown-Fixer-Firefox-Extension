{
  "manifest_version": 3,
  "name": "Gemini Code LaTeX Fixer",
  "version": "1.0.1",
  "description": "Reverses Gemini's \\( \\) LaTeX-escaping bug inside code blocks (PowerShell, etc.)",
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-latex-fixer-v2@jmitchell.local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://gemini.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-injector.js"],
      "matches": ["https://gemini.google.com/*"]
    }
  ]
}